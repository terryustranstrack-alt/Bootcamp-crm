NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings > API > service_role) — SERVER-ONLY,
# jangan pakai prefix NEXT_PUBLIC_. Dipakai fitur Data Sales untuk
# membuat/menghapus akun login. Jangan pernah expose ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API resmi (Meta) — lihat README bagian "Setup WhatsApp"
# untuk cara dapatkan nilai-nilai ini. Semua SERVER-ONLY.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App secret dari Meta App Dashboard > Settings > Basic, dipakai buat
# verifikasi header X-Hub-Signature-256 di webhook.
WHATSAPP_APP_SECRET=
# String bebas kamu tentukan sendiri, dipakai pas setup webhook di Meta
# App Dashboard (handshake hub.verify_token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
